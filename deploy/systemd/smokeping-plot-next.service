# System-wide service: /etc/systemd/system/smokeping-plot-next.service
#
# Runs as a dynamically allocated unprivileged user; CAP_NET_RAW lets it open
# raw ICMP sockets, CAP_NET_BIND_SERVICE lets it bind ports < 1024 if you set
# LISTEN=:80 in /etc/smokeping-plot-next/env.
[Unit]
Description=smokeping-plot-next latency monitor
Documentation=https://github.com/pomhg/smokeping-plot-next
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=smokeping-plot-next
Environment=DATA_DIR=/var/lib/smokeping-plot-next
Environment=LISTEN=:8080
EnvironmentFile=-/etc/smokeping-plot-next/env
ExecStart=/usr/local/bin/smokeping-plot-next
Restart=always
RestartSec=3
LimitNOFILE=65536

# capabilities
AmbientCapabilities=CAP_NET_RAW CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# hardening
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
