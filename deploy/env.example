# smokeping-plot-next configuration (systemd EnvironmentFile)
# System install: /etc/smokeping-plot-next/env
# User install:   ~/.config/smokeping-plot-next/env
# Restart the service after editing.

# Listen on all interfaces so LAN machines can reach the UI.
LISTEN=:8080

# Defaults for newly created targets
DEFAULT_STEP=60
DEFAULT_PINGS=20

# Delay between the pings of one round / per-ping timeout
PING_INTERVAL=500ms
PING_TIMEOUT=2s

# ICMP socket mode: auto | true (raw socket) | false (unprivileged UDP)
PROBE_PRIVILEGED=auto

# Retention
RAW_RETENTION_DAYS=30
ROLLUP_RETENTION_DAYS=730

# Optional HTTP basic auth for the whole UI/API
#AUTH_USER=admin
#AUTH_PASS=change-me

# LOG_LEVEL=debug
